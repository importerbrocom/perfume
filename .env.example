# Copy to .env on the server (never commit .env). Load into wp-config.php with getenv(), e.g.
#   define('DB_PASSWORD', getenv('DB_PASSWORD'));
# Gateway keys can alternatively be entered in WooCommerce > Settings > Payments.

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

WP_HOME=https://perfumarathi.com
WP_ENV=production

# Payment gateway (choose the one approved for your UAE merchant account)
PAYMENT_GATEWAY=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MODE=test   # test | live

# Transactional email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
